# Application
NODE_ENV=development
PORT=3004
SERVICE_NAME=fleetos-fleet-service
LOG_LEVEL=debug

# Database
# Format: mongodb://<username>:<password>@<host>:<port>/<db>?authSource=<auth_db>
DATABASE_URL=mongodb://<username>:<password>@<host>:<port>/<database>?authSource=<auth_db>

# Cache
# Format: redis://<host>:<port> or redis://:<password>@<host>:<port>
REDIS_URL=redis://<host>:<port>

# Message Broker
KAFKA_BROKER=kafka.infrastructure.svc.cluster.local:9092

# Auth Service
AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_API_KEY=dev-internal-key
